  const pglgSvg = $("#pglgChart");
  const freqRange = $("#freqRange");
  const freqOut = $("#freqOut");
  const freqReadout = $("#freqReadout");
  let freqLine = null;
  let freqDotE = null;
  let freqDotQ = null;
  let freqLabel = null;

  const explosionRatio = (f) => 0.06 * f + 0.22 * Math.tanh((f - 1.2) / 1.3) - 0.14;
  const earthquakeRatio = (f) => -0.22 + 0.12 * (1 - Math.exp(-f / 6));

  function buildPgLg() {
    if (!pglgSvg) return;
    pglgSvg.innerHTML = "";
    const W = 720, H = 390, L = 64, R = 30, T = 30, B = 54;
    const x = (f) => L + ((f - 0.5) / 19.5) * (W - L - R);
    const y = (v) => H - B - ((v + 0.8) / 2.2) * (H - T - B);

    const defs = svgEl("defs");
    const clip = svgEl("clipPath", { id: "pglgClip" });
    clip.appendChild(svgEl("rect", { x: L, y: T, width: W - L - R, height: H - T - B }));
    defs.appendChild(clip);
    pglgSvg.appendChild(defs);

    // noise bands
    const bands = [
      { x1: x(0.5), x2: x(1.5), label: "低頻噪訊" },
      { x1: x(16), x2: x(20), label: "高頻噪訊" }
    ];
    bands.forEach((b) => {
      pglgSvg.appendChild(svgEl("rect", {
        x: b.x1, y: T, width: Math.max(0, b.x2 - b.x1), height: H - T - B,
        fill: "rgba(84,107,128,.10)"
      }));
      addText(pglgSvg, (b.x1 + b.x2) / 2, T + 14, b.label, {
        "text-anchor": "middle", class: "axis-title"
      });
    });

    // axes
    const axis = svgEl("g", { class: "chart-axis" });
    for (let f = 0; f <= 20; f += 2) {
      axis.appendChild(svgEl("line", { x1: x(f), y1: T, x2: x(f), y2: H - B, class: "chart-tick" }));
      addText(axis, x(f), H - B + 22, f, { "text-anchor": "middle" });
    }
    [-0.8, -0.4, 0, 0.4, 0.8, 1.2].forEach((v) => {
      axis.appendChild(svgEl("line", { x1: L, y1: y(v), x2: W - R, y2: y(v), class: "chart-tick" }));
      addText(axis, L - 12, y(v) + 4, v.toFixed(1), { "text-anchor": "end" });
    });
    axis.appendChild(svgEl("line", { x1: L, y1: H - B, x2: W - R, y2: H - B, stroke: "rgba(76,62,45,.45)" }));
    axis.appendChild(svgEl("line", { x1: L, y1: T, x2: L, y2: H - B, stroke: "rgba(76,62,45,.45)" }));
    addText(axis, (L + W - R) / 2, H - 16, "頻率 (Hz)", { "text-anchor": "middle", class: "axis-title" });
    addText(axis, 15, (T + H - B) / 2, "Log(Pg/Lg)", {
      "text-anchor": "middle", class: "axis-title",
      transform: `rotate(-90 15 ${(T + H - B) / 2})`
    });
    pglgSvg.appendChild(axis);

    // zero line
    pglgSvg.appendChild(svgEl("line", {
      x1: L, y1: y(0), x2: W - R, y2: y(0),
      stroke: "rgba(76,62,45,.35)", "stroke-width": "1", "stroke-dasharray": "5 5"
    }));

    // curves
    function pathFor(fn) {
      let d = "";
      for (let i = 0; i <= 240; i++) {
        const f = 0.5 + (i / 240) * 19.5;
        d += `${i === 0 ? "M" : "L"}${x(f).toFixed(1)} ${y(fn(f)).toFixed(1)} `;
      }
      return d;
    }
    const ePath = svgEl("path", {
      d: pathFor(explosionRatio), fill: "none", stroke: "var(--red)",
      "stroke-width": "2.6", "stroke-linecap": "round"
    });
    const qPath = svgEl("path", {
      d: pathFor(earthquakeRatio), fill: "none", stroke: "var(--teal)",
      "stroke-width": "2.2", "stroke-linecap": "round", "stroke-dasharray": "7 5"
    });
    pglgSvg.appendChild(qPath);
    pglgSvg.appendChild(ePath);

    addText(pglgSvg, x(14.6), y(explosionRatio(14.6)) - 12, "爆炸", {
      class: "screening-label", "text-anchor": "middle"
    });
    addText(pglgSvg, x(14.6), y(earthquakeRatio(14.6)) + 20, "天然地震", {
      class: "axis-title", fill: "var(--teal)", "text-anchor": "middle"
    });

    // interactive line
    const g = svgEl("g", { "clip-path": "url(#pglgClip)" });
    freqLine = svgEl("line", {
      x1: x(6), y1: T, x2: x(6), y2: H - B,
      stroke: "rgba(76,62,45,.55)", "stroke-width": "1.2", "stroke-dasharray": "4 4"
    });
    freqDotE = svgEl("circle", { cx: x(6), cy: y(explosionRatio(6)), r: 6, fill: "var(--red)", stroke: "var(--paper-3)", "stroke-width": "2.5" });
    freqDotQ = svgEl("circle", { cx: x(6), cy: y(earthquakeRatio(6)), r: 5, fill: "var(--teal)", stroke: "var(--paper-3)", "stroke-width": "2" });
    g.appendChild(freqLine);
    g.appendChild(freqDotE);
    g.appendChild(freqDotQ);
    pglgSvg.appendChild(g);

    freqLabel = addText(pglgSvg, x(6), T + 24, "6.0 Hz", {
      "text-anchor": "middle", class: "screening-label"
    });
  }

  function updateFreq(f) {
    if (!freqLine) return;
    const W = 720, H = 390, L = 64, R = 30, T = 30, B = 54;
    const x = (v) => L + ((v - 0.5) / 19.5) * (W - L - R);
    const y = (v) => H - B - ((v + 0.8) / 2.2) * (H - T - B);
    const e = explosionRatio(f);
    const q = earthquakeRatio(f);
    freqLine.setAttribute("x1", x(f));
    freqLine.setAttribute("x2", x(f));
    freqDotE.setAttribute("cx", x(f));
    freqDotE.setAttribute("cy", y(e));
    freqDotQ.setAttribute("cx", x(f));
    freqDotQ.setAttribute("cy", y(q));
    freqLabel.setAttribute("x", x(f));
    freqLabel.textContent = `${f.toFixed(1)} Hz`;
    freqOut.textContent = `${f.toFixed(1)} Hz`;

    let verdict;
    if (f < 1.5) {
      verdict = "低頻段容易受背景微震噪訊影響，比值先保留。";
    } else if (e - q > 0.45) {
      verdict = "<b>爆炸特徵明顯</b>：Pg 相對 Lg 的能量高出許多。";
    } else if (e - q > 0.18) {
      verdict = "開始出現差距：爆炸的 Pg/Lg 比值逐漸拉開。";
    } else {
      verdict = "兩者還很接近，單靠這個頻率不容易分辨。";
    }
    freqReadout.innerHTML = `在 <b>${f.toFixed(1)} Hz</b>：爆炸 Log(Pg/Lg) ≈ <b>${e.toFixed(2)}</b>，天然地震 ≈ <b>${q.toFixed(2)}</b>。${verdict}`;
  }

  buildPgLg();
  if (freqRange) {
    freqRange.addEventListener("input", () => updateFreq(Number(freqRange.value)));
    updateFreq(Number(freqRange.value));
  }

