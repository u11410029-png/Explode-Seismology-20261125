  const attenSvg = $("#attenChart");
  const attenGroups = { continental: null, oceanic: null };

  function buildAtten() {
    if (!attenSvg) return;
    attenSvg.innerHTML = "";
    attenSvg.classList.add("atten-chart");
    const W = 640, H = 400, L = 66, R = 26, T = 28, B = 58;
    const x = (d) => L + ((d - 200) / 1000) * (W - L - R);
    const y = (amp) => {
      const log = Math.log10(amp);
      return H - B - ((log + 9) / 4) * (H - T - B);
    };

    // highlight band
    attenSvg.appendChild(svgEl("rect", {
      x: x(500), y: T, width: x(1000) - x(500), height: H - T - B, class: "atten-band"
    }));
    addText(attenSvg, (x(500) + x(1000)) / 2, T + 14, "500–1,000 km：方位角離散明顯", {
      "text-anchor": "middle", class: "atten-label"
    });

    // axes
    const axis = svgEl("g", { class: "chart-axis" });
    [200, 400, 600, 800, 1000, 1200].forEach((d) => {
      axis.appendChild(svgEl("line", { x1: x(d), y1: T, x2: x(d), y2: H - B, class: "chart-tick" }));
      addText(axis, x(d), H - B + 22, d, { "text-anchor": "middle" });
    });
    [-9, -8, -7, -6, -5].forEach((log) => {
      const yy = y(Math.pow(10, log));
      axis.appendChild(svgEl("line", { x1: L, y1: yy, x2: W - R, y2: yy, class: "chart-tick" }));
      addText(axis, L - 12, yy + 4, `10^${log}`, { "text-anchor": "end" });
    });
    axis.appendChild(svgEl("line", { x1: L, y1: H - B, x2: W - R, y2: H - B, stroke: "rgba(76,62,45,.45)" }));
    axis.appendChild(svgEl("line", { x1: L, y1: T, x2: L, y2: H - B, stroke: "rgba(76,62,45,.45)" }));
    addText(axis, (L + W - R) / 2, H - 16, "震央距 (km)", { "text-anchor": "middle", class: "axis-title" });
    addText(axis, 16, (T + H - B) / 2, "20 s 雷利波振幅 (m)", {
      "text-anchor": "middle", class: "axis-title",
      transform: `rotate(-90 16 ${(T + H - B) / 2})`
    });
    attenSvg.appendChild(axis);

    const rand = mulberry32(88);
    const stations = ["MDJ", "YAK", "ULN", "INCN", "TJN", "BATS", "KSNN", "MAJO", "ERM", "SSE"];
    const groups = { continental: [], oceanic: [] };
    attenGroups.continental = svgEl("g");
    attenGroups.oceanic = svgEl("g");

    for (let i = 0; i < 44; i++) {
      const dist = 230 + rand() * 950;
      const baseLog = Math.log10(8e-6) - 1.23 * Math.log10(dist / 300);
      const oceanic = i % 2 === 0;
      const scatter = (rand() + rand() - 1) * (oceanic ? 0.34 : 0.22);
      const logAmp = baseLog + scatter + (oceanic ? -0.28 : 0);
      const amp = Math.pow(10, clamp(logAmp, -8.8, -5.2));
      const station = stations[Math.floor(rand() * stations.length)];
      const circle = svgEl("circle", {
        cx: x(dist), cy: y(amp), r: 4.2 + rand() * 1.8,
        class: `atten-dot ${oceanic ? "oceanic-dot" : "continental-dot"}`,
        tabindex: "0"
      });
      const title = svgEl("title");
      title.textContent = `${oceanic ? "日本海／過渡路徑" : "大陸路徑"} · ${station} · ${Math.round(dist)} km · 振幅 ${amp.toExponential(2)} m`;
      circle.appendChild(title);
      (oceanic ? attenGroups.oceanic : attenGroups.continental).appendChild(circle);
      groups[oceanic ? "oceanic" : "continental"].push({ dist, amp });
    }

    Object.entries(groups).forEach(([key, pts]) => {
      // draw a smooth-ish trend through the cloud
      const sorted = pts.slice().sort((a, b) => a.dist - b.dist);
      let d = "";
      sorted.forEach((p, i) => {
        d += `${i === 0 ? "M" : "L"}${x(p.dist).toFixed(1)} ${y(p.amp).toFixed(1)} `;
      });
    });

    // explicitly draw the two reference trends
    function trendPath(oceanic) {
      let d = "";
      for (let i = 0; i <= 100; i++) {
        const dist = 200 + (i / 100) * 1000;
        const logAmp = Math.log10(8e-6) - 1.23 * Math.log10(dist / 300) + (oceanic ? -0.28 : 0);
        d += `${i === 0 ? "M" : "L"}${x(dist).toFixed(1)} ${y(Math.pow(10, logAmp)).toFixed(1)} `;
      }
      return d;
    }
    attenSvg.appendChild(svgEl("path", {
      d: trendPath(false), class: "atten-trend", stroke: "rgba(217,164,65,.75)"
    }));
    attenSvg.appendChild(svgEl("path", {
      d: trendPath(true), class: "atten-trend", stroke: "rgba(78,111,102,.75)"
    }));

    Object.values(attenGroups).forEach((g) => attenSvg.appendChild(g));

    const parent = attenSvg.parentElement;
    if (parent && !parent.querySelector(".chart-legend")) {
      const legend = document.createElement("div");
      legend.className = "chart-legend";
      legend.innerHTML = `<span><i class="legend-dot" style="background:#d9a441"></i>大陸路徑</span><span><i class="legend-dot" style="background:#4e6f66"></i>日本海／過渡路徑</span>`;
      parent.appendChild(legend);
    }
  }

