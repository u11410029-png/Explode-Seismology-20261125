  function renderDprkWave(index) {
    if (!dprkWave) return;
    const d = dprkData[index];
    dprkWave.innerHTML = "";
    const W = 760, H = 280, L = 50, R = 20, T = 24, B = 44;

    // grid
    const grid = svgEl("g", { class: "wave-grid" });
    for (let i = 0; i <= 5; i++) {
      const yy = T + ((H - T - B) / 5) * i;
      grid.appendChild(svgEl("line", { x1: L, y1: yy, x2: W - R, y2: yy }));
    }
    for (let i = 0; i <= 6; i++) {
      const xx = L + ((W - L - R) / 6) * i;
      grid.appendChild(svgEl("line", { x1: xx, y1: T, x2: xx, y2: H - B }));
    }
    dprkWave.appendChild(grid);

    // axes & time labels
    const axis = svgEl("g", { class: "chart-axis" });
    axis.appendChild(svgEl("line", { x1: L, y1: H - B, x2: W - R, y2: H - B, stroke: "rgba(76,62,45,.4)" }));
    for (let i = 0; i <= 6; i++) {
      const xx = L + ((W - L - R) / 6) * i;
      const sec = Math.round((i / 6) * 50);
      addText(axis, xx, H - B + 20, `${sec}s`, { "text-anchor": "middle" });
    }
    addText(axis, W / 2, H - 8, "Time (s)", { "text-anchor": "middle", class: "axis-title" });
    addText(axis, 14, T + 10, "振幅", { class: "axis-title" });
    dprkWave.appendChild(axis);

    // zero line
    const yBase = T + (H - T - B) / 2;
    dprkWave.appendChild(svgEl("line", {
      x1: L, y1: yBase, x2: W - R, y2: yBase, class: "wave-zero"
    }));

    // waveform
    const path = makeWavePath({
      x0: L + 4, x1: W - R - 4, yBase, scale: 74 * d.amp, amp: 1,
      seed: d.seed, duration: 50, type: "explosion", coda: d.coda
    });
    const wave = svgEl("path", { d: path, class: "wave-path" });
    if (index === 5) wave.style.stroke = "var(--red)";
    else if (index === 4) wave.style.stroke = "#b26a3c";
    else wave.style.stroke = "#7a6a4f";
    dprkWave.appendChild(wave);

    // phase markers
    const phases = [
      { t: 0.19, label: "Pn", color: "var(--blue)" },
      { t: 0.25, label: "Pg", color: "var(--red)" },
      { t: 0.6, label: "Lg", color: "var(--teal)" },
      { t: 0.84, label: "Rayleigh", color: "var(--mustard)" }
    ];
    phases.forEach((p) => {
      const xx = lerp(L, W - R, p.t);
      dprkWave.appendChild(svgEl("line", {
        x1: xx, y1: T, x2: xx, y2: H - B, class: "wave-phase-line"
      }));
      const label = addText(dprkWave, xx, T - 7, p.label, {
        "text-anchor": "middle", class: "wave-phase-text"
      });
      label.style.fill = p.color;
    });

    // small explanatory amplitude bracket
    if (index === 5) {
      addText(dprkWave, W - R - 6, T + 14, "2017：振幅跳級", {
        "text-anchor": "end", class: "wave-phase-text"
      });
    }

    dprkWaveTitle.textContent = d.title;
    dprkWaveBadge.textContent = d.badge;
    dprkWaveText.textContent = d.text;
    dprkWave.setAttribute("aria-label", `${d.title} 牡丹江測站波形示意`);
  }

