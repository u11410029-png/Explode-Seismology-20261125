        role: "button", "aria-label": `${d.label} 炸測位置`
      });
      const title = svgEl("title");
      title.textContent = `${d.label} · ${d.yieldKg} kg · ML ${d.ml}`;
      c.appendChild(title);
      const label = addText(g, cx + 10, cy + 3.5, d.label.replace(" / ", "/"), { class: "shot-label" });
      g.appendChild(c);
      g.appendChild(label);
      c.addEventListener("click", () => selectShot(id));
      c.addEventListener("keydown", (e) => {
        if (e.key === "Enter" || e.key === " ") { e.preventDefault(); selectShot(id); }
      });
      shotDotsGroup.appendChild(g);
    });
  }

  function selectShot(id) {
    const d = shotData[id];
    if (!d || !shotDetail) return;
    activeShot = id;
    shotDetail.innerHTML = `
      <span class="shot-badge">${d.label.replace(" / ", "/")}</span>
      <div><b>${d.yieldKg} kg · ML ${d.ml}</b><p>${d.note}</p></div>
    `;
    shotRows.forEach((row) => row.classList.toggle("is-active", row.dataset.shot === id));
    $$(".shot-dot", shotDotsGroup).forEach((dot) => {
      dot.classList.toggle("is-active", dot.dataset.shot === id);
    });
  }

  buildShotDots();
  if (shotRows.length) {
    shotRows.forEach((row) => {
      row.addEventListener("click", () => selectShot(row.dataset.shot));
      row.addEventListener("keydown", (e) => {
        if (e.key === "Enter" || e.key === " ") { e.preventDefault(); selectShot(row.dataset.shot); }
      });
    });
    selectShot(activeShot);
  }

  /* ---------------------------------------------------------
     Energy donut
     --------------------------------------------------------- */
  const energyData = [
    { key: "light", label: "光與熱", pct: 38, color: "#d9a441", text: "爆炸瞬間最直觀的能量形式；大部分能量其實都往這裡去了。比例為概念示意，非原始量測。" },
    { key: "sound", label: "聲波", pct: 27, color: "#4e6f66", text: "空氣中的聲波也是能量出口；大氣層核爆時，次聲波監測站就是靠這個訊號。" },
    { key: "rock", label: "圍岩破壞", pct: 30, color: "#b98a68", text: "把地表與周圍岩石震碎、掀翻的破壞能量。鑽井與覆蓋角礫石，就是為了把能量多留在這一步之前。" },
    { key: "seismic", label: "遠場地震波", pct: 5, color: "#b4472f", text: "只有極小比例真正變成能傳很遠的地震波。這就是為什麼炸藥量與測得規模不是完全一對一。" }
  ];
  const donut = $("#energyDonut");
  const energyLegend = $("#energyLegend");
  const energyReadout = $("#energyReadout");
  let activeEnergy = 0;

  function buildDonut() {
    if (!donut) return;
    let acc = 0;
    const stops = energyData.map((d) => {
      const start = acc;
      acc += d.pct;
      return `${d.color} ${start}% ${acc}%`;
    });
    donut.style.background = `conic-gradient(${stops.join(", ")})`;
  }

  function updateEnergy(index) {
    activeEnergy = index;
    const d = energyData[index];
    if (!donut || !energyReadout) return;
    $$("#energyLegend button").forEach((b, i) => b.classList.toggle("is-active", i === index));
    donut.style.boxShadow = `inset 0 0 0 1px rgba(76,62,45,.1), 0 0 0 5px ${d.color}22, var(--shadow)`;
    energyReadout.innerHTML = `<b>${d.label}（${d.pct}%）：</b>${d.text}`;
  }

  buildDonut();
  if (energyLegend) {
    $$("#energyLegend button").forEach((btn, i) => {
      btn.addEventListener("click", () => updateEnergy(i));
      btn.addEventListener("mouseenter", () => updateEnergy(i));
    });
    updateEnergy(0);
  }

  /* ---------------------------------------------------------
     PGV calculator
     --------------------------------------------------------- */
  const pgvSvg = $("#pgvChart");
  const pgvR = $("#pgvR");
  const pgvM = $("#pgvM");
  const pgvROut = $("#pgvROut");
  const pgvMOut = $("#pgvMOut");
  const pgvOut = $("#pgvOut");
  const pgvCm = $("#pgvCm");
  let pgvMarker = null;
  let pgvRing = null;
  let pgvGuideX = null;
  let pgvGuideY = null;
  let pgvCurve = null;
  let pgvLabel = null;
  let pgvMarkerText = null;

  const pgvLog = (R, M) => -1.43 * Math.log10(R) + 1.16 * M - 4.44;

  function buildPGV() {
    if (!pgvSvg) return;
    pgvSvg.innerHTML = "";
    const W = 680, H = 400, L = 72, R = 28, T = 28, B = 56;
    const x = (dist) => L + (Math.log10(dist) / 2) * (W - L - R);
    const y = (logv) => H - B - ((logv + 7) / 7.5) * (H - T - B);

    const axis = svgEl("g", { class: "chart-axis" });
    [1, 2, 5, 10, 20, 50, 100].forEach((d) => {
      axis.appendChild(svgEl("line", { x1: x(d), y1: T, x2: x(d), y2: H - B, class: "chart-tick" }));
      addText(axis, x(d), H - B + 22, d, { "text-anchor": "middle" });
    });
    [-7, -6, -5, -4, -3, -2, -1, 0].forEach((lv) => {
      axis.appendChild(svgEl("line", { x1: L, y1: y(lv), x2: W - R, y2: y(lv), class: "chart-tick" }));
      addText(axis, L - 12, y(lv) + 4, `10^${lv}`, { "text-anchor": "end" });
    });
    axis.appendChild(svgEl("line", { x1: L, y1: H - B, x2: W - R, y2: H - B, stroke: "rgba(76,62,45,.45)" }));
    axis.appendChild(svgEl("line", { x1: L, y1: T, x2: L, y2: H - B, stroke: "rgba(76,62,45,.45)" }));
    addText(axis, (L + W - R) / 2, H - 16, "震源距 R (km，對數)", { "text-anchor": "middle", class: "axis-title" });
    addText(axis, 17, (T + H - B) / 2, "PGV (m/s，對數)", {
      "text-anchor": "middle", class: "axis-title",
      transform: `rotate(-90 17 ${(T + H - B) / 2})`
    });
    pgvSvg.appendChild(axis);

    function curvePath(M) {
      let d = "";
      for (let i = 0; i <= 160; i++) {
        const dist = 1 + (i / 160) * 99;
        d += `${i === 0 ? "M" : "L"}${x(dist).toFixed(1)} ${y(pgvLog(dist, M)).toFixed(1)} `;
      }
      return d;
    }

    // family
    [1, 2, 3, 4].forEach((M) => {
      pgvSvg.appendChild(svgEl("path", { d: curvePath(M), class: "pgv-curve-ghost" }));
      addText(pgvSvg, x(1.35), y(pgvLog(1.35, M)) - 4, `M${M}`, {
        class: "pgv-label", fill: "rgba(180,71,47,.45)"
      });
    });

    pgvCurve = svgEl("path", { d: curvePath(2.38), class: "pgv-curve" });
    pgvSvg.appendChild(pgvCurve);

    pgvGuideX = svgEl("line", { x1: x(10), y1: T, x2: x(10), y2: H - B, class: "pgv-guide" });
    pgvGuideY = svgEl("line", { x1: L, y1: y(pgvLog(10, 2.38)), x2: W - R, y2: y(pgvLog(10, 2.38)), class: "pgv-guide" });
    pgvSvg.appendChild(pgvGuideX);
    pgvSvg.appendChild(pgvGuideY);

    pgvRing = svgEl("circle", { cx: x(10), cy: y(pgvLog(10, 2.38)), r: 13, class: "pgv-marker-ring" });
    pgvMarker = svgEl("circle", { cx: x(10), cy: y(pgvLog(10, 2.38)), r: 6.5, class: "pgv-marker" });
    pgvSvg.appendChild(pgvRing);
    pgvSvg.appendChild(pgvMarker);

    pgvMarkerText = addText(pgvSvg, x(10) + 16, y(pgvLog(10, 2.38)) - 14, "R = 10 km · M = 2.38", {
      class: "pgv-readout-label"
    });

    // legend
    addText(pgvSvg, L + 10, T + 16, "細線：不同規模的衰減曲線", { class: "axis-title" });
    addText(pgvSvg, L + 10, T + 31, "紅線：目前設定的規模", { class: "axis-title", fill: "var(--red)" });
  }

  function sciHTML(v) {
    if (!Number.isFinite(v)) return "—";
    if (v >= 0.01) return `${v.toFixed(3)}`;
    if (v <= 0) return "0";
    const exp = Math.floor(Math.log10(v));
    const mant = v / Math.pow(10, exp);
    const expText = String(exp).replace("-", "−");
    return `${mant.toFixed(2)} × 10<sup>${expText}</sup>`;
  }

  function updatePGV() {
    if (!pgvSvg || !pgvMarker) return;
    const R = Number(pgvR.value);
    const M = Number(pgvM.value);
    const logv = pgvLog(R, M);
    const v = Math.pow(10, logv);
    const W = 680, H = 400, L = 72, Rm = 28, T = 28, B = 56;
    const x = (dist) => L + (Math.log10(dist) / 2) * (W - L - Rm);
    const y = (lv) => H - B - ((lv + 7) / 7.5) * (H - T - B);

    pgvROut.textContent = `${R} km`;
    pgvMOut.textContent = M.toFixed(2);
    pgvOut.innerHTML = sciHTML(v);
    pgvCm.textContent = `${(v * 100).toFixed(v < 0.0001 ? 4 : 3)} cm/s`;

    // update selected curve
    let d = "";
    for (let i = 0; i <= 160; i++) {
      const dist = 1 + (i / 160) * 99;
      d += `${i === 0 ? "M" : "L"}${x(dist).toFixed(1)} ${y(pgvLog(dist, M)).toFixed(1)} `;
    }
    pgvCurve.setAttribute("d", d);

    pgvMarker.setAttribute("cx", x(R));
    pgvMarker.setAttribute("cy", y(logv));
    pgvRing.setAttribute("cx", x(R));
    pgvRing.setAttribute("cy", y(logv));
    pgvGuideX.setAttribute("x1", x(R));
    pgvGuideX.setAttribute("x2", x(R));
    pgvGuideY.setAttribute("y1", y(logv));
    pgvGuideY.setAttribute("y2", y(logv));
    pgvMarkerText.setAttribute("x", x(R) + 16);
    pgvMarkerText.setAttribute("y", y(logv) - 14);
    pgvMarkerText.textContent = `R = ${R} km · M = ${M.toFixed(2)}`;
  }

  buildPGV();
  if (pgvR && pgvM) {
    pgvR.addEventListener("input", updatePGV);
    pgvM.addEventListener("input", updatePGV);
    $$("[data-preset]").forEach((btn) => {
      btn.addEventListener("click", () => {
        if (btn.dataset.preset === "kaohsiung") { pgvR.value = "10"; pgvM.value = "2.38"; }
        if (btn.dataset.preset === "n3") { pgvR.value = "5"; pgvM.value = "2.63"; }
        if (btn.dataset.preset === "far") { pgvR.value = "50"; pgvM.value = "2.38"; }
        updatePGV();
      });
    });
    updatePGV();
  }

  /* ---------------------------------------------------------
     Quiz
     --------------------------------------------------------- */
  const quizData = [
    {
      q: "哪一組特徵最像「地下核試爆」？",
      options: [
        "高頻 Pg/Lg 比值偏高，且 mb 大、Ms 小",
        "表面波特別強，Ms 遠大於 mb",
        "震源機制是純雙力偶（DC）",
        "Lg 波很強，Pg 幾乎看不到"
      ],
      correct: 0,
      why: "爆炸是各向同性膨脹，P 波強、表面波弱，所以 mb 大、Ms 小；高頻 Pg 也相對 Lg 突出。"
    },
    {
      q: "同樣距離下，20 秒雷利波的振幅卻差很多，最主要原因是什麼？",
      options: [
        "測站的儀器顏色不同",
        "地下構造不均質，造成聚焦或散焦",
        "爆炸發生的日期不同",
        "20 秒這個週期選錯了"
      ],
      correct: 1,
      why: "穿越日本海薄海洋地殼與低速上部地函的路徑，散射與衰減較強；大陸穩定地塊則衰減較小。"
    },
    {
      q: "TAIGER 的 PGV 衰減式，主要用哪類測站資料建立？",
      options: [
        "西部厚層沉積平原測站",
        "山區與丘陵的岩盤測站",
        "海上氣槍震源",
        "北韓牡丹江測站"
      ],
      correct: 1,
      why: "研究刻意剔除受西部平原放大效應干擾的測站，只用山區與丘陵岩盤測站進行反演。"
    },
    {
      q: "2014 年高雄氣爆，利用 PGV 衰減式推估的等效區域規模約是多少？",
      options: ["ML 1.0", "ML 2.38", "ML 4.5", "ML 6.3"],
      correct: 1,
      why: "把各測站 5 Hz 垂直向 PGV 套入近地表爆炸衰減式，反推得到 ML ≈ 2.38。"
    }
  ];

  const quizBox = $("#quizBox");
  const quizProgress = $("#quizProgress");
  const quizRestart = $("#quizRestart");
  let quizIndex = 0;
  let quizScore = 0;
  let quizAnswered = false;

  function renderQuiz() {
    if (!quizBox) return;
    const q = quizData[quizIndex];
    quizAnswered = false;
    quizProgress.textContent = `${quizIndex + 1} / ${quizData.length}`;
    quizBox.innerHTML = `
      <p class="quiz-question">${q.q}</p>
      <div class="quiz-options">
        ${q.options.map((opt, i) => `<button class="quiz-option" type="button" data-opt="${i}">${opt}</button>`).join("")}
      </div>
      <div class="quiz-feedback" id="quizFeedback"></div>
      <button class="btn btn-solid quiz-next" id="quizNext" type="button">下一題 →</button>
    `;
    $$(".quiz-option", quizBox).forEach((btn) => {
      btn.addEventListener("click", () => answerQuiz(Number(btn.dataset.opt)));
    });
    const next = $("#quizNext", quizBox);
    next.addEventListener("click", () => {
      if (quizIndex < quizData.length - 1) {
        quizIndex++;
        renderQuiz();
      } else {
        showQuizResult();
      }
    });
  }

  function answerQuiz(choice) {
    if (quizAnswered) return;
    quizAnswered = true;
    const q = quizData[quizIndex];
    const correct = choice === q.correct;
    if (correct) quizScore++;
    $$(".quiz-option", quizBox).forEach((btn, i) => {
      btn.disabled = true;
      if (i === q.correct) btn.classList.add("is-correct");
      if (i === choice && !correct) btn.classList.add("is-wrong");
    });
    const feedback = $("#quizFeedback", quizBox);
    feedback.innerHTML = `<b>${correct ? "答對了。" : "再看一下。"}</b>${q.why}`;
    feedback.classList.add("is-visible");
    const next = $("#quizNext", quizBox);
    next.textContent = quizIndex < quizData.length - 1 ? "下一題 →" : "看成績 →";
    next.classList.add("is-visible");
  }

  function showQuizResult() {
    quizProgress.textContent = "完成";
    const perfect = quizScore === quizData.length;
    quizBox.innerHTML = `
      <div class="quiz-result">
        <p class="quiz-question">你答對了 ${quizScore} / ${quizData.length} 題。</p>
        <p>${perfect ? "全部答對！你已經抓到這場演講的核心：物理差異 → 波形特徵 → 衰減關係 → 真實應用。" : "沒關係，回到上面的章節再看一眼。這份筆記的目的不是考試，而是把硬的知識聽懂。"}</p>
        <button class="btn btn-solid" id="quizAgain" type="button">再玩一次</button>
      </div>
    `;
    $("#quizAgain", quizBox).addEventListener("click", () => {
      quizIndex = 0;
      quizScore = 0;
      renderQuiz();
    });
  }

  if (quizRestart) {
    quizRestart.addEventListener("click", () => {
      quizIndex = 0;
      quizScore = 0;
      renderQuiz();
    });
  }
  renderQuiz();

  /* ---------------------------------------------------------
     Keyboard section navigation (optional, subtle)
     --------------------------------------------------------- */
  document.addEventListener("keydown", (e) => {
    if (e.target.matches("input, textarea, select, button, a")) return;
    if (e.key !== "j" && e.key !== "k") return;
    const ids = ["top", "toc", "forensic", "difference", "dprk", "rayleigh", "taiger", "pgv", "reflection", "sources"];
    const current = ids.findIndex((id) => {
      const el = document.getElementById(id);
      if (!el) return false;
      const r = el.getBoundingClientRect();
      return r.top <= 140 && r.bottom > 140;
    });
    const next = e.key === "j" ? Math.min(current + 1, ids.length - 1) : Math.max(current - 1, 0);
    const target = document.getElementById(ids[next]);
    if (target) target.scrollIntoView({ behavior: reduceMotion ? "auto" : "smooth" });
  });

  /* ---------------------------------------------------------
     Small annual stamp: update footer year if needed
     --------------------------------------------------------- */
  const yearNodes = $$("[data-year]");
  yearNodes.forEach((n) => { n.textContent = new Date().getFullYear(); });
})();
