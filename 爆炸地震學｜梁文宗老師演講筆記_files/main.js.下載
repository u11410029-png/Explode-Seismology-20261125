/* =========================================================
   爆炸地震學 · 互動筆記
   Vanilla JS, no dependencies.
   ========================================================= */

(() => {
  "use strict";

  const $ = (sel, root = document) => root.querySelector(sel);
  const $$ = (sel, root = document) => Array.from(root.querySelectorAll(sel));
  const NS = "http://www.w3.org/2000/svg";
  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  const clamp = (v, min, max) => Math.min(max, Math.max(min, v));
  const lerp = (a, b, t) => a + (b - a) * t;

  function svgEl(name, attrs = {}) {
    const el = document.createElementNS(NS, name);
    Object.entries(attrs).forEach(([key, value]) => {
      if (value !== undefined && value !== null) el.setAttribute(key, value);
    });
    return el;
  }

  function addText(svg, x, y, text, attrs = {}) {
    const t = svgEl("text", { x, y, ...attrs });
    t.textContent = text;
    svg.appendChild(t);
    return t;
  }

  function mulberry32(seed) {
    let a = seed >>> 0;
    return function () {
      a |= 0;
      a = (a + 0x6D2B79F5) | 0;
      let t = Math.imul(a ^ (a >>> 15), 1 | a);
      t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
      return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
    };
  }

  function gauss(x, center, width) {
    const z = (x - center) / width;
    return Math.exp(-0.5 * z * z);
  }

  /* ---------------------------------------------------------
     Synthetic waveform path
     --------------------------------------------------------- */
  function makeWavePath({
    x0 = 40,
    x1 = 540,
    yBase = 140,
    scale = 60,
    amp = 1,
    seed = 7,
    duration = 50,
    type = "explosion",
    coda = false
  } = {}) {
    const rand = mulberry32(seed);
    const n = 760;
    const pts = [];
    const pnAmp = type === "explosion" ? 0.18 : 0.1;
    const pgAmp = type === "explosion" ? 0.52 : 0.2;
    const lgAmp = type === "explosion" ? 0.46 : 0.72;
    const rayAmp = type === "explosion" ? 0.34 : 0.42;

    for (let i = 0; i <= n; i++) {
      const t = i / n;
      const time = t * duration;
      let y = 0;

      // faint background noise, stronger near the coda
      y += (rand() - 0.5) * 0.032;

      // Pn: first, small and fast
      y += gauss(time, duration * 0.19, duration * 0.012) *
        Math.sin(time * 2 * Math.PI * 4.8 + 0.3) * pnAmp;

      // Pg: sharp high-frequency burst
      y += gauss(time, duration * 0.25, duration * 0.018) *
        Math.sin(time * 2 * Math.PI * (type === "explosion" ? 8.6 : 6.1) + 1.1) * pgAmp;

      // Lg: broad, longer-period shear-wave train
      y += gauss(time, duration * 0.6, duration * 0.16) *
        Math.sin(time * 2 * Math.PI * 2.35 + 0.6) * lgAmp;
      y += gauss(time, duration * 0.58, duration * 0.12) *
        Math.sin(time * 2 * Math.PI * 4.2 + 1.8) * lgAmp * 0.34;

      // 20 s Rayleigh packet near the end
      y += gauss(time, duration * 0.84, duration * 0.075) *
        Math.sin(time * 2 * Math.PI * 1.45 + 0.2) * rayAmp;

      // 2017-style tunnel-collapse coda
      if (coda) {
        y += gauss(time, duration * 0.965, duration * 0.025) *
          Math.sin(time * 2 * Math.PI * 3.2) * 0.22;
      }

      y = clamp(y * amp, -1, 1);
      const x = lerp(x0, x1, t);
      pts.push(`${x.toFixed(1)},${(yBase + y * scale).toFixed(1)}`);
    }
    return `M${pts.join(" L")}`;
  }

  /* ---------------------------------------------------------
     Top bar, progress, menu, active nav
     --------------------------------------------------------- */
  const topbar = $("#topbar");
  const progressBar = $("#progressBar");
  const menuBtn = $("#menuBtn");
  const siteNav = $("#siteNav");
  const navLinks = $$("#siteNav a");
  const sections = ["forensic", "difference", "dprk", "rayleigh", "taiger", "pgv", "reflection"]
    .map((id) => document.getElementById(id))
    .filter(Boolean);

  function onScroll() {
    const max = document.documentElement.scrollHeight - window.innerHeight;
    const p = max > 0 ? clamp(window.scrollY / max, 0, 1) : 0;
    progressBar.style.width = `${p * 100}%`;
    topbar.classList.toggle("is-scrolled", window.scrollY > 12);

    let active = "";
    sections.forEach((sec) => {
      if (sec.getBoundingClientRect().top <= 150) active = sec.id;
    });
    navLinks.forEach((a) => {
      a.classList.toggle("is-active", a.getAttribute("href") === `#${active}`);
    });
  }

  window.addEventListener("scroll", onScroll, { passive: true });
  window.addEventListener("resize", onScroll);
  onScroll();

  function closeMenu() {
    siteNav.classList.remove("is-open");
    menuBtn.setAttribute("aria-expanded", "false");
    document.body.classList.remove("menu-open");
  }

  menuBtn.addEventListener("click", () => {
    const open = siteNav.classList.toggle("is-open");
    menuBtn.setAttribute("aria-expanded", String(open));
    document.body.classList.toggle("menu-open", open);
  });

  navLinks.forEach((a) => a.addEventListener("click", closeMenu));
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") closeMenu();
  });
  document.addEventListener("click", (e) => {
    if (!siteNav.classList.contains("is-open")) return;
    if (siteNav.contains(e.target) || menuBtn.contains(e.target)) return;
    closeMenu();
  });
  window.addEventListener("resize", () => {
    if (window.innerWidth > 900) closeMenu();
  });

  /* ---------------------------------------------------------
     Reveal on scroll
     --------------------------------------------------------- */
  const revealEls = $$(".reveal");
  if ("IntersectionObserver" in window && !reduceMotion) {
    const io = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add("in");
          io.unobserve(entry.target);
        }
      });
    }, { threshold: 0.08, rootMargin: "0px 0px -40px 0px" });
    revealEls.forEach((el) => io.observe(el));
  } else {
    revealEls.forEach((el) => el.classList.add("in"));
  }

  /* ---------------------------------------------------------
     Print / copy link / toast
     --------------------------------------------------------- */
  const toast = $("#toast");
  let toastTimer = null;
  function showToast(msg) {
    toast.textContent = msg;
    toast.classList.add("is-visible");
    clearTimeout(toastTimer);
    toastTimer = setTimeout(() => toast.classList.remove("is-visible"), 2200);
  }

  ["#printBtn", "#printBtn2"].forEach((sel) => {
    const btn = $(sel);
    if (btn) btn.addEventListener("click", () => window.print());
  });

  const copyBtn = $("#copyLink");
  if (copyBtn) {
    copyBtn.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(window.location.href);
        showToast("連結已複製，可以貼給同學了");
      } catch {
        const ta = document.createElement("textarea");
        ta.value = window.location.href;
        ta.style.position = "fixed";
        ta.style.opacity = "0";
        document.body.appendChild(ta);
        ta.select();
        try { document.execCommand("copy"); showToast("連結已複製"); }
        catch { showToast("複製失敗，請從網址列手動複製"); }
        ta.remove();
      }
    });
  }

  /* ---------------------------------------------------------
     Flip cards (monitoring trio)
     --------------------------------------------------------- */
  $$(".flip-trigger").forEach((btn) => {
    btn.addEventListener("click", () => {
      const card = btn.closest(".monitor-card");
      const open = card.classList.toggle("is-open");
      btn.setAttribute("aria-expanded", String(open));
      const sign = $("span", btn);
      if (sign) sign.textContent = open ? "×" : "＋";
    });
  });

  /* ---------------------------------------------------------
     Hero: initial waveform + boom
     --------------------------------------------------------- */
  const hero = $(".hero");
  const heroWave = $("#heroWave");
  const boomBtn = $("#boomBtn");
  const boomReadout = $("#boomReadout");

  if (heroWave) {
    heroWave.setAttribute("d", makeWavePath({
      x0: 40, x1: 540, yBase: 145, scale: 61, amp: 0.92, seed: 11, duration: 50
    }));
  }

  if (boomBtn) {
    boomBtn.addEventListener("click", () => {
      if (!heroWave) return;
      const seed = Math.floor(Math.random() * 1000) + 3;
      heroWave.setAttribute("d", makeWavePath({
        x0: 40, x1: 540, yBase: 145, scale: 74, amp: 1.45, seed, duration: 50, coda: true
      }));
      if (boomReadout) boomReadout.textContent = "Pg 能量增強，Lg 也醒了";
      if (!reduceMotion) {
        hero.classList.remove("is-booming");
        void hero.offsetWidth;
        hero.classList.add("is-booming");
        setTimeout(() => hero.classList.remove("is-booming"), 650);
        burstParticles(boomBtn);
      }
    });
  }

  function burstParticles(originEl) {
    const rect = originEl.getBoundingClientRect();
    const cx = rect.left + rect.width / 2;
    const cy = rect.top + rect.height / 2;
    const words = ["P", "Pg", "Lg", "20s", "爆", "震", "PP", "PPP"];
    for (let i = 0; i < 9; i++) {
      const span = document.createElement("span");
      span.textContent = words[i % words.length];
      span.style.cssText = `
        position: fixed; left: ${cx}px; top: ${cy}px; z-index: 140;
        font-family: var(--hand); color: var(--red); font-size: ${14 + Math.random() * 12}px;
        pointer-events: none; will-change: transform, opacity;
      `;
      document.body.appendChild(span);
      const angle = (Math.PI * 2 * i) / 9 + Math.random() * 0.5;
      const dist = 70 + Math.random() * 90;
      const dx = Math.cos(angle) * dist;
      const dy = Math.sin(angle) * dist - 20;
      const anim = span.animate([
        { transform: "translate(-50%, -50%) scale(.6)", opacity: 0.95 },
        { transform: `translate(calc(-50% + ${dx}px), calc(-50% + ${dy}px)) scale(1.06) rotate(${Math.random() * 40 - 20}deg)`, opacity: 0 }
      ], { duration: 850 + Math.random() * 300, easing: "cubic-bezier(.16,.8,.3,1)" });
      anim.onfinish = () => span.remove();
    }
  }

  /* ---------------------------------------------------------
     MB–MS scatter chart
     --------------------------------------------------------- */
  const mbmsSvg = $("#mbmsChart");
  let quakeGroup = null;

  function buildMbMs() {
    if (!mbmsSvg) return;
    mbmsSvg.innerHTML = "";
    const W = 640, H = 430, L = 62, R = 24, T = 28, B = 58;
    const x = (v) => L + ((v - 2) / 5) * (W - L - R);
    const y = (v) => H - B - ((v - 2) / 5) * (H - T - B);

    const defs = svgEl("defs");
    const clip = svgEl("clipPath", { id: "mbmsClip" });
    clip.appendChild(svgEl("rect", { x: L, y: T, width: W - L - R, height: H - T - B }));
    defs.appendChild(clip);
    mbmsSvg.appendChild(defs);

    const axis = svgEl("g", { class: "chart-axis" });
    for (let v = 2; v <= 7; v++) {
      axis.appendChild(svgEl("line", { x1: L, y1: y(v), x2: W - R, y2: y(v), class: "chart-tick" }));
      axis.appendChild(svgEl("line", { x1: x(v), y1: T, x2: x(v), y2: H - B, class: "chart-tick" }));
      addText(axis, x(v), H - B + 22, v, { "text-anchor": "middle" });
      addText(axis, L - 14, y(v) + 4, v, { "text-anchor": "end" });
    }
    axis.appendChild(svgEl("line", { x1: L, y1: H - B, x2: W - R, y2: H - B, stroke: "rgba(76,62,45,.45)" }));
    axis.appendChild(svgEl("line", { x1: L, y1: T, x2: L, y2: H - B, stroke: "rgba(76,62,45,.45)" }));
    addText(axis, (L + W - R) / 2, H - 16, "體波規模 mb", { "text-anchor": "middle", class: "axis-title" });
    const yTitle = addText(axis, 16, (T + H - B) / 2, "表面波規模 Ms", {
      "text-anchor": "middle", class: "axis-title", transform: `rotate(-90 16 ${(T + H - B) / 2})`
    });
    yTitle.setAttribute("transform", `rotate(-90 16 ${(T + H - B) / 2})`);
    mbmsSvg.appendChild(axis);

    // screening line: Ms = 1.39 mb - 3.9
    const line = svgEl("path", {
      d: `M${x(2.8)} ${y(1.39 * 2.8 - 3.9)} L${x(7)} ${y(1.39 * 7 - 3.9)}`,
      class: "screening-line"
    });
    mbmsSvg.appendChild(line);
    const lineLabel = addText(mbmsSvg, x(6.05), y(1.39 * 6.05 - 3.9) - 10, "Ms = 1.39 mb − 3.9", {
      class: "screening-label", "text-anchor": "middle"
    });
    lineLabel.setAttribute("transform", `rotate(-31 ${x(6.05)} ${y(1.39 * 6.05 - 3.9) - 10})`);

    // earthquake cloud
    quakeGroup = svgEl("g", { "clip-path": "url(#mbmsClip)" });
    const rand = mulberry32(42);
    for (let i = 0; i < 190; i++) {
      let mb = 4.65 + (rand() + rand() + rand() - 1.5) * 0.75;
      mb = clamp(mb, 2.9, 6.7);
      let ms = 0.78 * mb + 0.35 + (rand() + rand() - 1) * 0.62;
      ms = clamp(ms, 2.15, 6.55);
      const c = svgEl("circle", {
        cx: x(mb), cy: y(ms), r: 2.7 + rand() * 1.8,
        class: "quake-dot", tabindex: "0"
      });
      const title = svgEl("title");
      title.textContent = `天然地震示例 · mb ${mb.toFixed(1)} / Ms ${ms.toFixed(1)}`;
      c.appendChild(title);
      quakeGroup.appendChild(c);
    }
    mbmsSvg.appendChild(quakeGroup);

    // explosion stars
    const stars = [
      { mb: 4.8, ms: 2.9, label: "China 950817" },
      { mb: 4.7, ms: 2.5, label: "China 960608" },
      { mb: 4.5, ms: 2.7, label: "Pakistan 980528" },
      { mb: 4.3, ms: 2.4, label: "India 980511" },
      { mb: 4.6, ms: 2.1, label: "China 960729" },
      { mb: 4.1, ms: 2.6, label: "DPRK 061009" }
    ];
    const starGroup = svgEl("g");
    stars.forEach((s) => {
      const g = svgEl("g");
      const star = svgEl("path", {
        d: starPath(x(s.mb), y(s.ms), 8, 3.5),
        class: "explosion-star",
        tabindex: "0"
      });
      const title = svgEl("title");
      title.textContent = `爆炸／推定爆炸 · ${s.label} · mb ${s.mb} / Ms ${s.ms}`;
      star.appendChild(title);
      g.appendChild(star);
      starGroup.appendChild(g);
    });
    mbmsSvg.appendChild(starGroup);

    // legend
    const parent = mbmsSvg.parentElement;
    if (parent && !parent.querySelector(".chart-legend")) {
      const legend = document.createElement("div");
      legend.className = "chart-legend";
      legend.innerHTML = `<span><i class="legend-dot"></i>天然地震（藍色群集）</span><span><i class="legend-star">★</i>爆炸／推定爆炸</span><span>虛線：篩選線</span>`;
      parent.appendChild(legend);
    }
  }

  function starPath(cx, cy, outer, inner, points = 5) {
    let d = "";
    for (let i = 0; i < points * 2; i++) {
      const r = i % 2 === 0 ? outer : inner;
      const a = -Math.PI / 2 + (i * Math.PI) / points;
      const px = cx + Math.cos(a) * r;
      const py = cy + Math.sin(a) * r;
      d += `${i === 0 ? "M" : "L"}${px.toFixed(1)} ${py.toFixed(1)} `;
    }
    return d + "Z";
  }

  buildMbMs();

  $$("[data-mbms]").forEach((btn) => {
    btn.addEventListener("click", () => {
      $$("[data-mbms]").forEach((b) => b.classList.toggle("is-active", b === btn));
      const onlyExplosion = btn.dataset.mbms === "explosion";
      if (quakeGroup) {
        quakeGroup.style.transition = "opacity .3s";
        quakeGroup.style.opacity = onlyExplosion ? "0.08" : "1";
      }
    });
  });

  /* ---------------------------------------------------------
     Source-type plot / ISO slider
     --------------------------------------------------------- */
  const sourceSvg = $("#sourceType");
  const isoRange = $("#isoRange");
  const isoOut = $("#isoOut");
  const isoText = $("#isoText");
  let sourceMarker = null;
  let sourceRing = null;
  let sourceMarkerLabel = null;

  function buildSourceType() {
    if (!sourceSvg) return;
    sourceSvg.innerHTML = "";
    const cx = 180, cy = 180, top = 54, bottom = 306, left = 58, right = 302;

    const diamond = svgEl("polygon", {
      points: `${cx},${top} ${right},${cy} ${cx},${bottom} ${left},${cy}`,
      class: "source-diamond"
    });
    sourceSvg.appendChild(diamond);

    const axes = svgEl("g");
    axes.appendChild(svgEl("line", { x1: cx, y1: top, x2: cx, y2: bottom, class: "source-axis" }));
    axes.appendChild(svgEl("line", { x1: left, y1: cy, x2: right, y2: cy, class: "source-axis" }));
    sourceSvg.appendChild(axes);

    addText(sourceSvg, cx, 34, "+ISO", { "text-anchor": "middle", class: "source-label big red" });
    addText(sourceSvg, cx, 334, "−ISO", { "text-anchor": "middle", class: "source-label big" });
    addText(sourceSvg, 44, 184, "CLVD", { "text-anchor": "middle", class: "source-label" });
    addText(sourceSvg, 318, 184, "CLVD", { "text-anchor": "middle", class: "source-label" });
    addText(sourceSvg, cx, 186, "DC", { "text-anchor": "middle", class: "source-label big" });
    addText(sourceSvg, cx, 202, "雙力偶", { "text-anchor": "middle", class: "source-label" });

    // small reference contours
    [0.25, 0.5, 0.75].forEach((t) => {
      const yy = cy - (cy - top) * t;
      const w = (right - cx) * (1 - t) * 0.9 + 12;
      const line = svgEl("path", {
        d: `M${cx - w} ${yy} Q${cx} ${yy - 12} ${cx + w} ${yy}`,
        fill: "none",
        stroke: "rgba(76,62,45,.1)",
        "stroke-width": "1"
      });
      sourceSvg.appendChild(line);
    });

    // fixed 2017 event marker (label on the left to avoid overlapping the slider marker)
    const fixed = svgEl("g", { id: "sourceFixed" });
    const fixedY = cy - (cy - top) * 0.42;
    fixed.appendChild(svgEl("circle", {
      cx, cy: fixedY, r: 15,
      fill: "none", stroke: "rgba(78,111,102,.55)", "stroke-width": "1.2", "stroke-dasharray": "3 3"
    }));
    addText(fixed, cx + 22, fixedY + 4, "2017 · 42% ISO", {
      class: "source-label", fill: "#4e6f66"
    });
    sourceSvg.appendChild(fixed);

    sourceRing = svgEl("circle", { cx, cy: cy, r: 13, class: "source-marker-ring" });
    sourceMarker = svgEl("circle", { cx, cy: cy, r: 8, class: "source-marker" });
    sourceMarkerLabel = addText(sourceSvg, cx - 15, cy - 12, "目前設定", { class: "source-label red", "text-anchor": "end" });
    sourceSvg.appendChild(sourceRing);
    sourceSvg.appendChild(sourceMarker);
    sourceSvg.appendChild(sourceMarkerLabel);
  }

  function updateSource(iso) {
    if (!sourceMarker) return;
    const cx = 180, cy = 180, top = 54;
    const t = iso / 100;
    const my = cy - (cy - top) * t;
    const mx = cx + Math.sin(t * Math.PI) * 8;
    sourceMarker.setAttribute("cx", mx);
    sourceMarker.setAttribute("cy", my);
    sourceRing.setAttribute("cx", mx);
    sourceRing.setAttribute("cy", my);
    sourceMarkerLabel.setAttribute("x", mx - 15);
    sourceMarkerLabel.setAttribute("y", my - 12);
    const fixed = document.getElementById("sourceFixed");
    if (fixed) {
      fixed.style.transition = "opacity .25s";
      fixed.style.opacity = Math.abs(iso - 42) < 4 ? "0.18" : "1";
    }
    isoOut.textContent = `${iso}%`;

    if (iso < 15) {
      isoText.innerHTML = `接近<b>純 DC</b>：典型構造地震的剪切錯動，幾乎沒有膨脹成分。`;
    } else if (iso < 35) {
      isoText.innerHTML = `混合型：仍有明顯剪力成分，不能只靠 ISO 判定，需搭配 mb–Ms 與頻譜比。`;
    } else if (iso < 62) {
      isoText.innerHTML = `明顯的膨脹成分。2017 年北韓事件約 <b>42% ISO</b>、Mw 4.95，是核試爆的典型特徵。`;
    } else {
      isoText.innerHTML = `高度 <b>+ISO</b>：幾乎是純體積膨脹，和斷層錯動的震源機制很不一樣。`;
    }
  }

  buildSourceType();
  if (isoRange) {
    isoRange.addEventListener("input", () => updateSource(Number(isoRange.value)));
    updateSource(Number(isoRange.value));
  }

  /* ---------------------------------------------------------
     DPRK timeline + MDJ waveform
     --------------------------------------------------------- */
  const dprkData = [
    {
      year: "2006", date: "10 / 09", mb: "4.1", badge: "第一次",
      title: "2006 / 10 / 09 · mb 4.1",
      text: "規模約 4.1–4.3。初動 Pn、Pg 清晰，Lg 波相對較弱。",
      amp: 0.62, seed: 21, coda: false
    },
    {
      year: "2009", date: "05 / 25", mb: "4.7", badge: "波形高度相似",
      title: "2009 / 05 / 25 · mb 4.7",
      text: "規模約 4.7。波形與前一次高度相似，顯示震源位置與機制高度一致。",
      amp: 0.78, seed: 22, coda: false
    },
    {
      year: "2013", date: "02 / 12", mb: "5.1", badge: "高頻 Pg 增強",
      title: "2013 / 02 / 12 · mb 5.1",
      text: "規模約 5.1。高頻 Pg 能量顯著增強，是頻譜比分析的好例子。",
      amp: 0.92, seed: 23, coda: false
    },
    {
      year: "2016", date: "01 / 06", mb: "5.1", badge: "第四次",
      title: "2016 / 01 / 06 · mb 5.1",
      text: "規模約 5.1。與 2016 年 9 月那次波形互相關係數極高。",
      amp: 0.94, seed: 24, coda: false
    },
    {
      year: "2016", date: "09 / 09", mb: "5.3", badge: "第五次",
      title: "2016 / 09 / 09 · mb 5.3",
      text: "規模約 5.3。波形與同年 1 月事件高度相似，位置與機制一致。",
      amp: 1.0, seed: 25, coda: false
    },
    {
      year: "2017", date: "09 / 03", mb: "6.3", badge: "最大的一次",
      title: "2017 / 09 / 03 · mb 6.3",
      text: "規模高達 6.3，振幅遠大於前五次。主震後約 8.5 分鐘，伴隨坑道坍塌訊號。",
      amp: 1.48, seed: 26, coda: true
    }
  ];

  const dprkWave = $("#dprkWave");
  const dprkWaveTitle = $("#dprkWaveTitle");
  const dprkWaveBadge = $("#dprkWaveBadge");
  const dprkWaveText = $("#dprkWaveText");
